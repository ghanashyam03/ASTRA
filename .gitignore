# ====================================================================
# Git Ignore Rules - ASTRA Frontend Focus
# ====================================================================

# Node/Next.js (Frontend Caches & Artifacts)
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.env*.local
frontend/next-env.d.ts
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/.turbo/

# Python Virtual Environments
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.so

# Python Tooling & Caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Non-Frontend Source & Project Files
src/
tests/
config/
scripts/
docs/
Dockerfile
pyproject.toml
uv.lock
.python-version
*_result.json
results/
outputs/
benchmarks/output/

# Data & Kernels
data/
*.duckdb
*.duckdb.wal
*.zarr
*.parquet

# IDE & OS Configuration Files
.vscode/
.idea/
.DS_Store
Thumbs.db
.env
.env.*